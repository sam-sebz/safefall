# Copy this file to .env and fill in your values. Never share or commit .env.

# Required: signs login sessions. Use any long random text.
SECRET_KEY=

# Telegram alerts: create a bot with @BotFather to get the token.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids for the people who get alerts.
TELEGRAM_CHAT_IDS=
# Who gets the "still down" reminder. Leave empty to use TELEGRAM_CHAT_IDS.
TELEGRAM_ESCALATION_CHAT_IDS=

# Detection settings
DOWN_SECONDS=10
ESCALATE_SECONDS=60
UNWITNESSED_SECONDS=30
GRACE_SECONDS=3
TORSO_ANGLE_THRESHOLD=45
DROP_RATIO=0.5
SHRINK_RATIO=0
# Analysis size: smaller is faster, larger finds people further from the camera.
IMAGE_SIZE=320
CAMERAS_FILE=cameras.json

# Optional: set a private broker to keep sending MQTT alerts to the Android app.
MQTT_BROKER=

# Set to on once fall_tcn.pt is trained. Off uses the hand-written rules.
FALL_MODEL=off
# A repeat fall on a camera within this time joins its open alert instead of alerting again.
ALERT_COOLDOWN_SECONDS=120
# Keep at 0 while the app is reachable from the internet. Add people with create_user.py.
ALLOW_REGISTRATION=0
